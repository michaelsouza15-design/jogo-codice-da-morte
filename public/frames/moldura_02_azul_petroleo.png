<svg preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 1700" width="100%" height="100%" fill="none">
  <defs>
    <!-- Filter for drop shadow / 3D embossed look -->
    <filter id="shadow-AzulPetróleo" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.8"/>
    </filter>
    <filter id="glow-AzulPetróleo" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#06b6d4" flood-opacity="0.6"/>
    </filter>
    
    <!-- Linear Gradients -->
    <linearGradient id="goldGrad-AzulPetróleo" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f59e0b"/>
      <stop offset="35%" stop-color="#06b6d4"/>
      <stop offset="70%" stop-color="#083344"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>

    <linearGradient id="ironGrad-AzulPetróleo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#083344"/>
      <stop offset="50%" stop-color="#09090b"/>
      <stop offset="100%" stop-color="#083344"/>
    </linearGradient>

    <radialGradient id="gemGrad-AzulPetróleo" cx="35%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="45%" stop-color="#0e7490"/>
      <stop offset="85%" stop-color="#083344"/>
      <stop offset="100%" stop-color="#000000"/>
    </radialGradient>
  </defs>

  <!-- ================= OUTER FRAME BORDER ================= -->
  <!-- Outer Rim with Inset Profile -->
  <rect x="12" y="12" width="1176" height="1676" rx="32" ry="32" 
        stroke="url(#goldGrad-AzulPetróleo)" stroke-width="6" fill="none" />
  
  <!-- Outer Dark Iron Base Track -->
  <path d="
    M 50,18
    L 1150,18
    A 32,32 0 0,1 1182,50
    L 1182,1650
    A 32,32 0 0,1 1150,1682
    L 50,1682
    A 32,32 0 0,1 18,1650
    L 18,50
    A 32,32 0 0,1 50,18
    Z
    M 64,36
    A 16,16 0 0,0 36,64
    L 36,1636
    A 16,16 0 0,0 64,1664
    L 1136,1664
    A 16,16 0 0,0 1164,1636
    L 1164,64
    A 16,16 0 0,0 1136,36
    Z"
    fill="url(#ironGrad-AzulPetróleo)" fill-rule="evenodd" stroke="#06b6d4" stroke-width="2" />

  <!-- Inner Gold Bevel Line -->
  <rect x="36" y="36" width="1128" height="1628" rx="16" ry="16"
        stroke="#06b6d4" stroke-width="3" fill="none" opacity="0.9" />
  
  <!-- Inner Delicate Filigree Inset Line -->
  <rect x="44" y="44" width="1112" height="1612" rx="12" ry="12"
        stroke="#083344" stroke-width="1.5" fill="none" stroke-dasharray="8,4" opacity="0.8" />

  <!-- ================= 4 CORNER GOTHIC CUSPS & ARABESQUES ================= -->
  
  <!-- TOP-LEFT CORNER -->
  <g transform="translate(14, 14)">
    <!-- Base Corner Shield / Arch -->
    <path d="M 0,0 L 0,190 C 40,170 130,120 170,40 C 180,20 190,0 190,0 L 0,0 Z" 
          fill="url(#ironGrad-AzulPetróleo)" stroke="#06b6d4" stroke-width="3.5" />
    
    <!-- Gothic Trefoil / Cusps Arc -->
    <path d="M 12,175 C 45,155 70,120 70,90 C 70,60 40,40 12,25" 
          stroke="#f59e0b" stroke-width="3" fill="none"/>
    <path d="M 175,12 C 155,45 120,70 90,70 C 60,70 40,40 25,12" 
          stroke="#f59e0b" stroke-width="3" fill="none"/>
    
    <!-- Inner Leaf Filigree Scroll -->
    <path d="M 28,28 Q 75,35 90,80 Q 95,115 55,105 Q 35,98 38,70 Q 40,45 28,28 Z" 
          fill="#0e7490" stroke="#06b6d4" stroke-width="2" opacity="0.95" />
    <path d="M 45,45 Q 95,75 105,55 Q 115,35 80,90" 
          stroke="#38bdf8" stroke-width="2" fill="none" opacity="0.8"/>

    <!-- Corner Jewel Gemstone -->
    <circle cx="58" cy="58" r="18" fill="url(#gemGrad-AzulPetróleo)" stroke="#fbbf24" stroke-width="3.5" filter="url(#glow-AzulPetróleo)"/>
    <circle cx="54" cy="54" r="5" fill="#ffffff" opacity="0.6"/>
    <!-- Gem Star Accent -->
    <path d="M 58,34 L 58,82 M 34,58 L 82,58 M 41,41 L 75,75 M 41,75 L 75,41" stroke="#fbbf24" stroke-width="1.5" opacity="0.7"/>
  </g>

  <!-- TOP-RIGHT CORNER -->
  <g transform="translate(1186, 14) scale(-1, 1)">
    <path d="M 0,0 L 0,190 C 40,170 130,120 170,40 C 180,20 190,0 190,0 L 0,0 Z" 
          fill="url(#ironGrad-AzulPetróleo)" stroke="#06b6d4" stroke-width="3.5" />
    <path d="M 12,175 C 45,155 70,120 70,90 C 70,60 40,40 12,25" 
          stroke="#f59e0b" stroke-width="3" fill="none"/>
    <path d="M 175,12 C 155,45 120,70 90,70 C 60,70 40,40 25,12" 
          stroke="#f59e0b" stroke-width="3" fill="none"/>
    <path d="M 28,28 Q 75,35 90,80 Q 95,115 55,105 Q 35,98 38,70 Q 40,45 28,28 Z" 
          fill="#0e7490" stroke="#06b6d4" stroke-width="2" opacity="0.95" />
    <path d="M 45,45 Q 95,75 105,55 Q 115,35 80,90" 
          stroke="#38bdf8" stroke-width="2" fill="none" opacity="0.8"/>
    <circle cx="58" cy="58" r="18" fill="url(#gemGrad-AzulPetróleo)" stroke="#fbbf24" stroke-width="3.5" filter="url(#glow-AzulPetróleo)"/>
    <circle cx="54" cy="54" r="5" fill="#ffffff" opacity="0.6"/>
    <path d="M 58,34 L 58,82 M 34,58 L 82,58 M 41,41 L 75,75 M 41,75 L 75,41" stroke="#fbbf24" stroke-width="1.5" opacity="0.7"/>
  </g>

  <!-- BOTTOM-LEFT CORNER -->
  <g transform="translate(14, 1686) scale(1, -1)">
    <path d="M 0,0 L 0,190 C 40,170 130,120 170,40 C 180,20 190,0 190,0 L 0,0 Z" 
          fill="url(#ironGrad-AzulPetróleo)" stroke="#06b6d4" stroke-width="3.5" />
    <path d="M 12,175 C 45,155 70,120 70,90 C 70,60 40,40 12,25" 
          stroke="#f59e0b" stroke-width="3" fill="none"/>
    <path d="M 175,12 C 155,45 120,70 90,70 C 60,70 40,40 25,12" 
          stroke="#f59e0b" stroke-width="3" fill="none"/>
    <path d="M 28,28 Q 75,35 90,80 Q 95,115 55,105 Q 35,98 38,70 Q 40,45 28,28 Z" 
          fill="#0e7490" stroke="#06b6d4" stroke-width="2" opacity="0.95" />
    <path d="M 45,45 Q 95,75 105,55 Q 115,35 80,90" 
          stroke="#38bdf8" stroke-width="2" fill="none" opacity="0.8"/>
    <circle cx="58" cy="58" r="18" fill="url(#gemGrad-AzulPetróleo)" stroke="#fbbf24" stroke-width="3.5" filter="url(#glow-AzulPetróleo)"/>
    <circle cx="54" cy="54" r="5" fill="#ffffff" opacity="0.6"/>
    <path d="M 58,34 L 58,82 M 34,58 L 82,58 M 41,41 L 75,75 M 41,75 L 75,41" stroke="#fbbf24" stroke-width="1.5" opacity="0.7"/>
  </g>

  <!-- BOTTOM-RIGHT CORNER -->
  <g transform="translate(1186, 1686) scale(-1, -1)">
    <path d="M 0,0 L 0,190 C 40,170 130,120 170,40 C 180,20 190,0 190,0 L 0,0 Z" 
          fill="url(#ironGrad-AzulPetróleo)" stroke="#06b6d4" stroke-width="3.5" />
    <path d="M 12,175 C 45,155 70,120 70,90 C 70,60 40,40 12,25" 
          stroke="#f59e0b" stroke-width="3" fill="none"/>
    <path d="M 175,12 C 155,45 120,70 90,70 C 60,70 40,40 25,12" 
          stroke="#f59e0b" stroke-width="3" fill="none"/>
    <path d="M 28,28 Q 75,35 90,80 Q 95,115 55,105 Q 35,98 38,70 Q 40,45 28,28 Z" 
          fill="#0e7490" stroke="#06b6d4" stroke-width="2" opacity="0.95" />
    <path d="M 45,45 Q 95,75 105,55 Q 115,35 80,90" 
          stroke="#38bdf8" stroke-width="2" fill="none" opacity="0.8"/>
    <circle cx="58" cy="58" r="18" fill="url(#gemGrad-AzulPetróleo)" stroke="#fbbf24" stroke-width="3.5" filter="url(#glow-AzulPetróleo)"/>
    <circle cx="54" cy="54" r="5" fill="#ffffff" opacity="0.6"/>
    <path d="M 58,34 L 58,82 M 34,58 L 82,58 M 41,41 L 75,75 M 41,75 L 75,41" stroke="#fbbf24" stroke-width="1.5" opacity="0.7"/>
  </g>

  <!-- ================= 4 CENTRAL MEDALLIONS / GOTHIC FLEUR-DE-LIS PEAKS ================= -->

  <!-- TOP CENTER FLEURON -->
  <g transform="translate(600, 24)">
    <path d="M 0,-18 L 18,0 L 0,18 L -18,0 Z" fill="url(#ironGrad-AzulPetróleo)" stroke="#06b6d4" stroke-width="3" />
    <path d="M 0,-24 L 6,-6 L 24,0 L 6,6 L 0,24 L -6,6 L -24,0 L -6,-6 Z" fill="#0e7490" stroke="#fbbf24" stroke-width="1.5" />
    <circle cx="0" cy="0" r="7" fill="url(#gemGrad-AzulPetróleo)" stroke="#f59e0b" stroke-width="2" />
    <path d="M -40,0 Q -25,-12 0,-18 Q 25,-12 40,0" stroke="#06b6d4" stroke-width="2" fill="none"/>
  </g>

  <!-- BOTTOM CENTER FLEURON -->
  <g transform="translate(600, 1676) scale(1, -1)">
    <path d="M 0,-18 L 18,0 L 0,18 L -18,0 Z" fill="url(#ironGrad-AzulPetróleo)" stroke="#06b6d4" stroke-width="3" />
    <path d="M 0,-24 L 6,-6 L 24,0 L 6,6 L 0,24 L -6,6 L -24,0 L -6,-6 Z" fill="#0e7490" stroke="#fbbf24" stroke-width="1.5" />
    <circle cx="0" cy="0" r="7" fill="url(#gemGrad-AzulPetróleo)" stroke="#f59e0b" stroke-width="2" />
    <path d="M -40,0 Q -25,-12 0,-18 Q 25,-12 40,0" stroke="#06b6d4" stroke-width="2" fill="none"/>
  </g>

  <!-- LEFT CENTER FLEURON -->
  <g transform="translate(24, 850) rotate(-90)">
    <path d="M 0,-18 L 18,0 L 0,18 L -18,0 Z" fill="url(#ironGrad-AzulPetróleo)" stroke="#06b6d4" stroke-width="3" />
    <path d="M 0,-24 L 6,-6 L 24,0 L 6,6 L 0,24 L -6,6 L -24,0 L -6,-6 Z" fill="#0e7490" stroke="#fbbf24" stroke-width="1.5" />
    <circle cx="0" cy="0" r="7" fill="url(#gemGrad-AzulPetróleo)" stroke="#f59e0b" stroke-width="2" />
    <path d="M -40,0 Q -25,-12 0,-18 Q 25,-12 40,0" stroke="#06b6d4" stroke-width="2" fill="none"/>
  </g>

  <!-- RIGHT CENTER FLEURON -->
  <g transform="translate(1176, 850) rotate(90)">
    <path d="M 0,-18 L 18,0 L 0,18 L -18,0 Z" fill="url(#ironGrad-AzulPetróleo)" stroke="#06b6d4" stroke-width="3" />
    <path d="M 0,-24 L 6,-6 L 24,0 L 6,6 L 0,24 L -6,6 L -24,0 L -6,-6 Z" fill="#0e7490" stroke="#fbbf24" stroke-width="1.5" />
    <circle cx="0" cy="0" r="7" fill="url(#gemGrad-AzulPetróleo)" stroke="#f59e0b" stroke-width="2" />
    <path d="M -40,0 Q -25,-12 0,-18 Q 25,-12 40,0" stroke="#06b6d4" stroke-width="2" fill="none"/>
  </g>
</svg>